<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JARVIS O.S. - Arc Reactor HUD</title>
    <style>
        :root {
            --glow-color: #00f3ff;
            --bg-dark: #030712;
            --hud-transparency: rgba(0, 243, 255, 0.1);
            --font-hud: 'Courier New', Courier, monospace;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-dark);
            color: var(--glow-color);
            font-family: var(--font-hud);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            text-shadow: 0 0 10px var(--glow-color);
        }

        /* Scanline Effekt */
        .scanline {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: rgba(0, 243, 255, 0.3);
            opacity: 0.5;
            animation: scan 6s linear infinite;
            z-index: 10;
            pointer-events: none;
        }

        @keyframes scan {
            0% { top: 0%; }
            100% { top: 100%; }
        }

        /* Hauptcontainer im Kreis-HUD-Stil */
        .hud-container {
            position: relative;
            width: 90vw;
            max-width: 600px;
            height: 90vh;
            max-height: 600px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 2;
        }

        /* Das Arc-Reactor / Hologramm Zentrum basierend auf dem Bild */
        .arc-reactor-hud {
            position: relative;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            border: 2px dashed rgba(0, 243, 255, 0.4);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 30px rgba(0, 243, 255, 0.2), inset 0 0 30px rgba(0, 243, 255, 0.2);
            animation: rotateSlow 20s linear infinite;
            margin-bottom: 20px;
        }

        .ring-inner {
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            border: 2px solid var(--glow-color);
            box-shadow: 0 0 15px var(--glow-color);
            animation: rotateReverse 15s linear infinite;
        }

        .ring-core {
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0,243,255,0.3) 0%, rgba(3,7,18,0.9) 80%);
            border: 2px solid var(--glow-color);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            box-shadow: 0 0 25px var(--glow-color);
        }

        /* Animationen für die Ringe */
        @keyframes rotateSlow {
            100% { transform: rotate(360deg); }
        }
        @keyframes rotateReverse {
            100% { transform: rotate(-360deg); }
        }

        /* Pulsieren wenn die KI spricht oder zuhört */
        .hud-container.active .arc-reactor-hud {
            border-color: #ff9900;
            box-shadow: 0 0 50px rgba(255, 153, 0, 0.4), inset 0 0 40px rgba(255, 153, 0, 0.4);
        }
        .hud-container.active .ring-inner {
            border-color: #ff9900;
            box-shadow: 0 0 25px #ff9900;
        }
        .hud-container.active .ring-core {
            border-color: #ff9900;
            background: radial-gradient(circle, rgba(255,153,0,0.4) 0%, rgba(3,7,18,0.9) 80%);
            box-shadow: 0 0 35px #ff9900;
        }

        .hud-title {
            font-size: 1.4rem;
            letter-spacing: 3px;
            font-weight: bold;
        }

        .hud-status {
            font-size: 0.75rem;
            color: #8be9fd;
            margin-top: 5px;
        }

        /* Konsolen-Ausgabe für Live-Gespräch */
        .conversation-box {
            width: 100%;
            height: 120px;
            overflow-y: auto;
            background: rgba(0, 243, 255, 0.05);
            border: 1px solid rgba(0, 243, 255, 0.3);
            padding: 10px;
            font-size: 0.85rem;
            border-radius: 4px;
            margin-bottom: 15px;
            box-sizing: border-box;
        }

        /* Steuerungsleiste */
        .control-panel {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        input[type="password"], input[type="text"] {
            background: rgba(0, 243, 255, 0.1);
            border: 1px solid var(--glow-color);
            color: var(--glow-color);
            padding: 10px;
            font-family: var(--font-hud);
            font-size: 0.9rem;
            outline: none;
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
        }

        .button-group {
            display: flex;
            gap: 10px;
        }

        button {
            background: var(--glow-color);
            color: var(--bg-dark);
            border: none;
            padding: 10px 15px;
            font-family: var(--font-hud);
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 0 10px var(--glow-color);
            transition: all 0.2s;
            border-radius: 4px;
            flex-grow: 1;
        }

        button:hover {
            background: #00c9d4;
            box-shadow: 0 0 20px var(--glow-color);
        }

        button.mic-btn {
            background: transparent;
            color: var(--glow-color);
            border: 1px solid var(--glow-color);
            max-width: 60px;
            font-size: 1.2rem;
        }

        button.mic-btn.listening {
            background: #ff9900;
            color: var(--bg-dark);
            border-color: #ff9900;
            box-shadow: 0 0 20px #ff9900;
            animation: pulseMic 1s infinite alternate;
        }

        @keyframes pulseMic {
            from { transform: scale(1); }
            to { transform: scale(1.05); }
        }
    </style>
</head>
<body>

    <div class="scanline"></div>

    <div class="hud-container" id="hud-container">
        <!-- Das kreisrunde Arc-Reactor HUD Design -->
        <div class="arc-reactor-hud">
            <div class="ring-inner"></div>
            <div class="ring-core">
                <div class="hud-title">J.A.R.V.I.S.</div>
                <div class="hud-status" id="status-text">BEREIT</div>
            </div>
        </div>

        <!-- Live Gesprächsverlauf -->
        <div class="conversation-box" id="chat-log">
            <p>> System initialisiert. Bereit für Live-Interaktion.</p>
        </div>

        <!-- Eingaben & Live Steuerung -->
        <div class="control-panel">
            <input type="password" id="api-key" placeholder="Groq API-Schlüssel eingeben...">
            <div class="button-group">
                <input type="text" id="user-input" placeholder="Nachricht an JARVIS...">
                <button class="mic-btn" id="mic-btn" onclick="toggleLiveVoice()" title="Live Sprachmodus">🎤</button>
                <button onclick="sendToJarvis()">SENDEN</button>
            </div>
        </div>
    </div>

    <script>
        let recognition = null;
        let isLiveActive = false;
        let conversationHistory = [
            { role: 'system', content: 'Du bist JARVIS, ein hochintelligenter, treuer KI-Assistent im Stil von Tony Stark. Du sprichst präzise, direkt, professionell und auf Deutsch.' }
        ];

        // Text-to-Speech (Männliche Stimme)
        function speak(text, callback) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'de-DE';
                utterance.pitch = 0.8; // Tiefe, coole Stimme
                utterance.rate = 1.05;

                const voices = window.speechSynthesis.getVoices();
                const maleVoice = voices.find(v => v.lang.includes('de') && (v.name.includes('Male') || v.name.includes('Stefan') || v.name.includes('Google Deutsch')));
                if (maleVoice) utterance.voice = maleVoice;

                utterance.onend = function() {
                    if (callback) callback();
                };

                window.speechSynthesis.speak(utterance);
            } else if (callback) {
                callback();
            }
        }

        // Live-Sprachmodus (Kontinuierliches Reden mit Mikrofon)
        function toggleLiveVoice() {
            const apiKey = document.getElementById('api-key').value;
            if (!apiKey) {
                alert("Bitte erst den Groq API-Schlüssel eingeben.");
                return;
            }

            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
                alert("Dein Browser unterstützt keine Spracherkennung.");
                return;
            }

            const micBtn = document.getElementById('mic-btn');
            const hudContainer = document.getElementById('hud-container');
            const statusText = document.getElementById('status-text');

            if (isLiveActive) {
                if (recognition) recognition.stop();
                isLiveActive = false;
                micBtn.classList.remove('listening');
                hudContainer.classList.remove('active');
                statusText.innerText = "BEREIT";
                return;
            }

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.lang = 'de-DE';
            recognition.continuous = false;
            recognition.interimResults = false;

            recognition.onstart = function() {
                isLiveActive = true;
                micBtn.classList.add('listening');
                hudContainer.classList.add('active');
                statusText.innerText = "HÖRE ZU...";
            };

            recognition.onresult = async function(event) {
                const speechText = event.results[0][0].transcript;
                document.getElementById('user-input').value = speechText;
                await processCommand(speechText);
            };

            recognition.onerror = function(event) {
                console.error("Sprachfehler:", event.error);
            };

            recognition.onend = function() {
                if (isLiveActive) {
                    try {
                        recognition.start(); // Direkt wieder aufnehmen für echten Live-Fluss
                    } catch(e) {
                        isLiveActive = false;
                        micBtn.classList.remove('listening');
                        hudContainer.classList.remove('active');
                        statusText.innerText = "BEREIT";
                    }
                }
            };

            recognition.start();
        }

        // Anfrage an Groq senden (Llama 3.3 70B stabiler Endpunkt)
        async function sendToJarvis() {
            const inputField = document.getElementById('user-input');
            const text = inputField.value.trim();
            if (text) {
                inputField.value = '';
                await processCommand(text);
            }
        }

        async function processCommand(text) {
            const apiKey = document.getElementById('api-key').value;
            const chatLog = document.getElementById('chat-log');
            const statusText = document.getElementById('status-text');
            const hudContainer = document.getElementById('hud-container');

            if (!apiKey) {
                alert("API-Schlüssel fehlt.");
                return;
            }

            chatLog.innerHTML += `<p style="color: var(--glow-color);">> ${text}</p>`;
            conversationHistory.push({ role: 'user', content: text });

            statusText.innerText = "ANALYSIERE...";
            hudContainer.classList.add('active');

            try {
                const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        model: 'llama-3.3-70b-versatile',
                        messages: conversationHistory,
                        temperature: 0.7
                    })
                });

                const data = await response.json();

                if (data.choices && data.choices.length > 0) {
                    const reply = data.choices[0].message.content;
                    chatLog.innerHTML += `<p style="color: #ffffff; border-left: 2px solid #ff9900; padding-left: 6px;">> ${reply}</p>`;
                    conversationHistory.push({ role: 'assistant', content: reply });
                    
                    statusText.innerText = "SPRICHT";
                    chatLog.scrollTop = chatLog.scrollHeight;

                    // KI antwortet per Sprachausgabe
                    speak(reply, () => {
                        if (!isLiveActive) {
                            statusText.innerText = "BEREIT";
                            hudContainer.classList.remove('active');
                        } else {
                            statusText.innerText = "HÖRE ZU...";
                        }
                    });
                } else {
                    statusText.innerText = "FEHLER";
                    chatLog.innerHTML += `<p style="color: red;">> API-Fehler aufgetreten.</p>`;
                    hudContainer.classList.remove('active');
                }
            } catch (error) {
                statusText.innerText = "VERBINDUNGSFEHLER";
                chatLog.innerHTML += `<p style="color: red;">> ${error.message}</p>`;
                hudContainer.classList.remove('active');
            }
            chatLog.scrollTop = chatLog.scrollHeight;
        }

        // Stimmen vorladen
        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
        }
    </script>
</body>
</html>
